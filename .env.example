# Zkopíruj do .env a doplň skutečné hodnoty. .env je v .gitignore.

# --- Mosquitto (interní MQTT broker) ---
MQTT_PORT=1883
MQTT_BROKER_URL=tcp://mqtt_broker:1883

# --- TimescaleDB (PostgreSQL 18) ---
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=dashboarder

# --- ValkeyDB (Redis-compatible, zatím appkou nevyužito) ---
VALKEY_PORT=6379
VALKEY_PASSWORD=changeme

# --- Externí MQTT zdroj pro mqtt-inputer (bridge na cizí broker) ---
SOURCE_MQTT_URL=tcp://broker.example.com:1883
SOURCE_MQTT_TOPIC=/your/source/topic/#

# --- Sdílený HMAC klíč (musí sedět se secret_key v configs/*.yaml) ---
SECRET_KEY=changeme

LOG_LEVEL=info
